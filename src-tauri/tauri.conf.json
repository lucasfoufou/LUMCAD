{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LUMCAD",
  "version": "0.1.0",
  "identifier": "io.github.lucasfoufou.lumcad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LUMCAD",
        "width": 1500,
        "height": 950,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "copyright": "Copyright © 2026 Lucas FOUGERAS and DIGITAL CACTUS",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE"
    },
    "shortDescription": "Open-source, AI-enabled 2D CAD software",
    "longDescription": "LUMCAD is a lightweight, multi-platform CAD application designed to simplify 2D plan generation through local drawing tools and AI integration.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["lcad"],
        "name": "LUMCAD Drawing",
        "description": "LUMCAD drawing",
        "mimeType": "application/x-lumcad",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "io.github.lucasfoufou.lumcad.drawing",
          "conformsTo": ["public.zip-archive", "public.data"]
        }
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFNjFEOTM0NkYzNEYwODEKUldTQjhEUnZOTmxoVG4vTmxVVnlNcFpZdHV6UUo3aHU2Tnc0TmNlUm9WOEJDb0NTY3Bhbmt4OXAK",
      "endpoints": [
        "https://github.com/lucasfoufou/LUMCAD/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
